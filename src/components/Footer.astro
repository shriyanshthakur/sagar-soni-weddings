---
---

<footer id="contact" class="bg-brand-charcoal text-white pt-24 pb-12 relative overflow-hidden">
  
  <!-- Subtle gold background accents -->
  <div class="absolute top-0 right-0 w-[400px] h-[400px] rounded-full bg-brand-gold/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    
    <!-- Top Interactive Section: Contact details and Inquiry Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 pb-20 border-b border-brand-gold/15">
      
      <!-- Left: Contact Details & Google Map -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-brand-gold mb-3 block">Reach Out</span>
          <h2 class="text-3xl sm:text-5xl font-serif tracking-wide">
            Begin the <span class="font-serif-italic font-normal text-brand-gold">Journey</span>
          </h2>
          <div class="w-16 h-[1px] bg-brand-gold mt-4"></div>
        </div>

        <p class="text-sm font-light text-white/80 leading-relaxed max-w-sm">
          Where service starts before the event. Let us know your event vision, and our team will get back to you within 24 hours.
        </p>

        <!-- Details List -->
        <div class="space-y-6 pt-4">
          
          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-brand-gold mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 01-7.108-7.108c-.155-.44.011-.927.387-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold block mb-1">Call Us</span>
              <a href="tel:+919826123366" class="text-sm hover:text-brand-gold transition-colors duration-300 block focus-gold">098261 23366</a>
              <a href="tel:+919827044993" class="text-sm hover:text-brand-gold transition-colors duration-300 block focus-gold">9827044993</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-brand-gold mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold block mb-1">Email Us</span>
              <a href="mailto:sagarsonievent@gmail.com" class="text-sm hover:text-brand-gold transition-colors duration-300 block focus-gold">sagarsonievent@gmail.com</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-brand-gold mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25s-7.5-4.108-7.5-11.25C4.5 6.358 7.858 3 12 3c4.142 0 7.5 3.358 7.5 7.5z"/>
            </svg>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold block mb-1">Location</span>
              <p class="text-sm text-white/90 leading-relaxed font-light">
                Lohar Chowk, Sonar Para, Purani Basti, Raipur, Chhattisgarh 492001
              </p>
            </div>
          </div>

        </div>

        <!-- Google Map Iframe (Interactive) -->
        <div class="w-full h-56 rounded-sm overflow-hidden border border-brand-gold/20 shadow-inner">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3719.167888764121!2d81.62648797587747!3d21.22522778103099!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a28dd177a641775%3A0xe50e0473a268e0a3!2sLohar%20Chowk%2C%20Sonar%20Para%2C%20Purani%20Basti%2C%20Raipur%2C%20Chhattisgarh%20492001!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
            class="w-full h-full border-0 filter invert-[0.9] hue-rotate-[180deg]" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Sagar Soni Weddings Office Location Map"
          ></iframe>
        </div>

      </div>

      <!-- Right: Premium Contact/Inquiry Form -->
      <div class="lg:col-span-7 bg-white/[0.03] border border-white/10 rounded-sm p-8 sm:p-10 shadow-lg">
        <h3 class="font-serif text-2xl text-white mb-6">
          Schedule Your <span class="font-serif-italic font-normal text-brand-gold">Consultation</span>
        </h3>
        
        <form class="space-y-6" id="inquiry-form">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Full Name -->
            <div>
              <label for="name" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Full Name *</label>
              <input 
                type="text" 
                id="name" 
                required 
                placeholder="Jane Doe" 
                class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3 px-4 text-sm text-white placeholder-white/40 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Email Address</label>
              <input 
                type="email" 
                id="email" 
                placeholder="jane@example.com" 
                class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3 px-4 text-sm text-white placeholder-white/40 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
              />
            </div>

          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Phone -->
            <div>
              <label for="phone" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Phone Number *</label>
              <input 
                type="tel" 
                id="phone" 
                required 
                placeholder="+91 98765 43210" 
                class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3 px-4 text-sm text-white placeholder-white/40 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
              />
            </div>

            <!-- Event Date -->
            <div>
              <label for="date" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Wedding / Event Date</label>
              <input 
                type="date" 
                id="date" 
                class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3 px-4 text-sm text-white focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
              />
            </div>

          </div>

          <!-- Services Needed -->
          <div>
            <label for="services-needed" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Services Required</label>
            <select 
              id="services-needed" 
              class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3.5 px-4 text-sm text-white focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
            >
              <option value="all-inclusive" class="bg-brand-charcoal">Complete Wedding Planning (End-to-End)</option>
              <option value="catering" class="bg-brand-charcoal">Premium Catering Only</option>
              <option value="decor" class="bg-brand-charcoal">Theme Decor & Lighting</option>
              <option value="sangeet" class="bg-brand-charcoal">Ladies Sangeet & Sound</option>
              <option value="photography" class="bg-brand-charcoal">Photography & Cinematography</option>
              <option value="custom" class="bg-brand-charcoal">Bespoke Custom Package</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-[10px] font-bold uppercase tracking-widest text-brand-gold mb-2">Tell Us About Your Vision</label>
            <textarea 
              id="message" 
              rows="4" 
              placeholder="Describe details, theme ideas, guest counts..." 
              class="w-full bg-brand-charcoal border border-white/20 rounded-sm py-3 px-4 text-sm text-white placeholder-white/40 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors duration-300"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="w-full py-4 bg-brand-gold hover:bg-brand-gold-dark text-white font-semibold text-xs tracking-widest uppercase rounded-sm transition-all duration-300 shadow-md focus-gold"
          >
            Submit Inquiry
          </button>

          <!-- Success Alert Message -->
          <div id="form-success" class="hidden p-4 bg-brand-sage/20 border border-brand-sage rounded-sm text-center text-brand-sage text-sm font-medium animate-fade-in">
            Thank you! Your inquiry has been sent successfully. Sagar Soni will reach out to you shortly.
          </div>

        </form>

      </div>

    </div>

    <!-- Bottom copyright / social bar -->
    <div class="pt-12 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Footer Logo -->
      <span class="font-serif text-base font-semibold tracking-wide text-white">
        Sagar Soni <span class="font-serif-italic text-brand-gold text-xs ml-0.5">Weddings</span>
      </span>

      <!-- Navigation shortcuts -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold uppercase tracking-widest text-white/60">
        <a href="#services" class="hover:text-brand-gold transition-colors duration-300">Services</a>
        <a href="#gallery" class="hover:text-brand-gold transition-colors duration-300">Gallery</a>
        <a href="#calculator" class="hover:text-brand-gold transition-colors duration-300">Budget Planner</a>
        <a href="#testimonials" class="hover:text-brand-gold transition-colors duration-300">Reviews</a>
        <a href="#about" class="hover:text-brand-gold transition-colors duration-300">About</a>
      </nav>

      <!-- Copyright -->
      <div class="text-[11px] text-white/50 text-center md:text-right font-light leading-relaxed">
        <p>&copy; {new Date().getFullYear()} Sagar Soni Weddings. All Rights Reserved.</p>
        <p class="mt-1">Lohar Chowk, Raipur (C.G.). Established 2000.</p>
      </div>

    </div>

  </div>
</footer>

<script>
  const form = document.getElementById('inquiry-form');
  const successMsg = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Retrieve input values safely
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const phone = (document.getElementById('phone') as HTMLInputElement).value;
    const date = (document.getElementById('date') as HTMLInputElement).value;
    const serviceSelect = document.getElementById('services-needed') as HTMLSelectElement;
    const serviceText = serviceSelect.options[serviceSelect.selectedIndex].text;
    const vision = (document.getElementById('message') as HTMLTextAreaElement).value;

    // Build structured luxury WhatsApp text
    const whatsappMsg = `Hello Sagar Soni Weddings,%0A%0AI would like to book a consultation. Here are my celebration details:%0A%0A• *Name:* ${encodeURIComponent(name)}%0A• *Phone:* ${encodeURIComponent(phone)}%0A• *Email:* ${encodeURIComponent(email || 'N/A')}%0A• *Event Date:* ${encodeURIComponent(date || 'To Be Confirmed')}%0A• *Services Selected:* ${encodeURIComponent(serviceText)}%0A• *Event Vision:* ${encodeURIComponent(vision || 'N/A')}%0A%0APlease let me know your availability. Thank you!`;

    // Redirection
    window.open(`https://wa.me/919826123366?text=${whatsappMsg}`, '_blank');
    
    // Clear inputs and display completion alert
    if (successMsg) {
      successMsg.classList.remove('hidden');
      
      const inputs = form.querySelectorAll('input, textarea, select');
      inputs.forEach(input => {
        if (input instanceof HTMLInputElement && input.type !== 'submit') {
          input.value = '';
        } else if (input instanceof HTMLTextAreaElement) {
          input.value = '';
        }
      });
      
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 6000);
    }
  });
</script>
