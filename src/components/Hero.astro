---
---

<section class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
  
  <!-- Background Image with Fade-in and zoom animation -->
  <div class="absolute inset-0 z-0 scale-105 animate-[scale-up_10s_ease-out_forwards] bg-[#1a1212]">
    <img 
      src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=65&w=1200&auto=format&fit=crop" 
      alt="Luxurious Indian Wedding Setup" 
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-[1.05]"
    />
    <!-- Romantic warm overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal/70 via-brand-charcoal/40 to-brand-ivory"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center flex flex-col items-center">
    
    <!-- Established Tag -->
    <span class="inline-block px-4 py-1.5 border border-brand-gold/40 rounded-full text-brand-gold bg-black/20 text-xs font-semibold uppercase tracking-widest mb-6 animate-fade-in">
      Premier Wedding Planner Since 2000
    </span>

    <!-- Main Heading with Playfair Display Serif and italicized accents -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-white tracking-wide leading-tight mb-8 max-w-4xl drop-shadow-md animate-[fade-in-up_1.2s_cubic-bezier(0.16,1,0.3,1)_forwards]">
      Memorable <span class="font-serif-italic font-normal text-brand-gold">Celebrations</span>, Seamlessly <span class="font-serif-italic font-normal text-brand-gold">Crafted</span>.
    </h1>

    <!-- Elegant Subtitle -->
    <p class="text-base sm:text-xl text-white/90 font-light max-w-2xl leading-relaxed mb-12 tracking-wide animate-[fade-in-up_1.4s_cubic-bezier(0.16,1,0.3,1)_forwards]">
      Central India's premier wedding planning agency. Elevating Raipur's most grand milestones with bespoke styling, legendary catering, and execution where service starts before the event.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-5 items-center justify-center w-full sm:w-auto animate-[fade-in-up_1.6s_cubic-bezier(0.16,1,0.3,1)_forwards]">
      <a 
        href="#contact" 
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-brand-gold hover:bg-brand-gold-dark text-white text-sm font-semibold tracking-widest uppercase transition-all duration-300 rounded-sm shadow-md hover:shadow-lg hover:-translate-y-0.5 focus-gold"
      >
        Plan Your Dream Wedding
      </a>
      <a 
        href="#gallery" 
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border border-white/40 hover:border-brand-gold bg-black/10 hover:bg-white hover:text-brand-charcoal text-white text-sm font-semibold tracking-widest uppercase transition-all duration-300 rounded-sm focus-gold"
      >
        Explore Our Gallery
      </a>
    </div>

  </div>

  <!-- Animated Bottom Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-[10px] font-semibold tracking-widest uppercase text-brand-charcoal/60">Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-charcoal/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>

</section>
