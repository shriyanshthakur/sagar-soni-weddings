---
const reviews = [
  {
    name: "Mohit Sahu",
    role: "Groom",
    rating: 5,
    quote: "Great service within my budget, best food quality. Sagar Soni events handled everything from mandap decorators to the multi-course outdoor buffet. Extremely impressive team!",
    date: "November 2025"
  },
  {
    name: "Ridhi Sharma",
    role: "Bride",
    rating: 5,
    quote: "Very impressive design of work and area look and act Royal. The Ladies Sangeet choreography was a massive hit, and the sound & lighting design was concert grade. Highly recommended in Raipur!",
    date: "January 2026"
  },
  {
    name: "Rajesh Dewangan",
    role: "Father of the Bride",
    rating: 5,
    quote: "Since 2000, they have been a household name in Purani Basti, but their upgrade to luxury styles is unmatched. Unbelievable eye for detail, and they truly mean it when they say service starts before the event.",
    date: "December 2025"
  }
];
---

<section id="testimonials" class="py-24 sm:py-32 bg-brand-ivory-dark/25 relative overflow-hidden">
  
  <!-- Decorative Background Glows -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[350px] h-[350px] rounded-full bg-brand-gold/5 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-brand-sage/5 blur-[150px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 sm:mb-24">
      <span class="text-xs font-semibold uppercase tracking-widest text-brand-gold mb-3 block">Testimonials</span>
      <h2 class="text-3xl sm:text-5xl font-serif tracking-wide text-brand-charcoal">
        Voices of <span class="font-serif-italic font-normal text-brand-gold">Gratitude</span>
      </h2>
      <div class="w-16 h-[1px] bg-brand-gold mx-auto mt-4 mb-6"></div>
      <p class="text-brand-charcoal-light font-light text-sm sm:text-base leading-relaxed">
        Nothing honors us more than the stories of our clients. Here is what families in Raipur and beyond say about our signature wedding experiences.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev) => (
        <div class="glass-card bg-white p-8 sm:p-10 rounded-sm border border-brand-gold/15 flex flex-col justify-between h-full relative group">
          
          <!-- Large gold quotation mark background -->
          <span class="absolute right-8 top-6 text-7xl font-serif text-brand-gold/10 select-none pointer-events-none">“</span>

          <div>
            <!-- Star Ratings -->
            <div class="flex items-center gap-1 mb-6">
              {[...Array(rev.rating)].map(() => (
                <svg class="w-4 h-4 text-brand-gold fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <blockquote class="text-sm sm:text-base text-brand-charcoal/90 leading-relaxed font-light italic mb-8">
              "{rev.quote}"
            </blockquote>
          </div>

          <!-- Reviewer Identity -->
          <div class="border-t border-brand-gold/10 pt-6 flex items-center justify-between">
            <div>
              <cite class="not-italic text-sm font-semibold text-brand-charcoal block group-hover:text-brand-gold transition-colors duration-300">
                {rev.name}
              </cite>
              <span class="text-[10px] font-bold text-brand-charcoal-light/70 uppercase tracking-widest block mt-0.5">
                {rev.role}
              </span>
            </div>
            <span class="text-[10px] text-brand-sage font-semibold uppercase tracking-wider">
              {rev.date}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- Verified Badge -->
    <div class="mt-16 text-center">
      <div class="inline-flex items-center gap-3 px-6 py-3 border border-brand-gold/20 rounded-full bg-white/50 text-xs font-semibold text-brand-charcoal-light">
        <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>Verified Google Reviews (4.9 / 5.0 Rating Across 108+ Reviews)</span>
      </div>
    </div>

  </div>
</section>
